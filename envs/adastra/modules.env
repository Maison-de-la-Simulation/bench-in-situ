export CRAYPE_LINK_TYPE=dynamic
module purge
module load PrgEnv-cray
module load cray-python

export PYTHON_VERSION="311"
export SNAPSHOT_FILE_PATH=${SCRATCHDIR}/bench-in-situ

declare -A problem_subdivisions=(
    ['1']=" 1 1 1 "
    ['2']=" 2 1 1 "
    ['4']=" 2 2 1 "
    ['8']=" 2 2 2 "
    ['16']=" 4 2 2 "
    ['32']=" 4 4 2 "
    ['64']=" 4 4 4 "
    ['128']=" 4 4 8 "
)

declare -A problem_subdivisions_small=(
    ['16']=" 4 2 2 "
)

MINIMUM_CUBE_SIZE=64
MAXIMUM_CUBE_SIZE=512
SMALL_CUBE_SIZE=128
